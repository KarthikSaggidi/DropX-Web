<IfModule mod_rewrite.c>
  RewriteEngine On

  # Let Apache serve real files (including Vite's hashed CSS and JS) normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React Router handles all application routes after the initial document.
  RewriteRule ^ index.html [L]
</IfModule>
